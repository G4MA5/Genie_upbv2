{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "next": {
      "root": "./",
      "framework": "nextjs"
    },
    "equipes": {
      "root": "inscriptions-equipes/",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": {
          "maxDuration": 60,
          "excludeFiles": "{tests/**,stockage_local/**,**/__pycache__/**,.pytest_cache/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(auth|referentiel|espace|moi|etudiants|equipes|invitations|admin|sante)",
      "destination": { "service": "equipes" }
    },
    {
      "source": "/api/(auth|referentiel|espace|moi|etudiants|equipes|invitations|admin|sante)/(.*)",
      "destination": { "service": "equipes" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "next" }
    }
  ]
}
