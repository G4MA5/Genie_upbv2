# =============================================================================
# GÉNIE UPB — variables d'environnement des DEUX backends (un seul fichier .env)
#   * Next.js (racine de backend/)      : invités, personnel, badges
#   * FastAPI (inscriptions-equipes/)   : inscriptions étudiants et équipes
# Copier en backend/.env et compléter. Les deux serveurs lisent ce même fichier.
# En production (Vercel / Render), définir ces mêmes noms dans chaque projet.
# Ne jamais committer le vrai .env.
# =============================================================================

# --- Supabase (communes aux deux backends) -----------------------------------
# Project Settings › API / API Keys. Garder ces noms en minuscules.
supabase_url=https://<ref>.supabase.co
supabase_anon_key=
supabase_service_role_key=

# --- Brevo, e-mails (communes) -----------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=GÉNIE UPB

# --- Frontend (commune) : origines autorisées (CORS), séparées par des virgules
FRONT_ORIGINS=http://localhost:5173,https://www.le-genie-upb.com,https://le-genie-upb.com

# --- FastAPI uniquement -------------------------------------------------------
# Connexion Postgres Supabase. En serverless (Vercel) : pooler en mode transaction, port 6543.
DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe-encode>@aws-0-<region>.pooler.supabase.com:6543/postgres
STORAGE_BACKEND=supabase
# API base étudiants UPB, point d'entrée partenaire (POST /api/partenaire/verifier)
UPB_API_URL=https://api.dbupb.synapstic.tech
UPB_API_KEY=
UPB_API_MODE=live
EMAIL_ENABLED=true
# Sessions candidats : 32 caractères minimum
JWT_SECRET=
JWT_EXPIRE_HOURS=2160
# Accès organisateurs (validation des équipes, en-tête X-Admin-Key)
ADMIN_API_KEY=
INSCRIPTIONS_CLOTURE=2026-12-18T23:59:59Z
# Lien vers le frontend dans les e-mails
FRONTEND_URL=https://www.le-genie-upb.com

# --- Next.js uniquement -------------------------------------------------------
# Codes et jetons des invités : 16 caractères minimum
APP_SECRET=
# API base étudiants UPB, point d'entrée public (adresse complète)
PCO_API_URL=https://api.dbupb.synapstic.tech/api/verifier
PCO_API_KEY=
# Page du frontend qui reçoit le lien « nouveau mot de passe »
FRONT_RESET_URL=https://www.le-genie-upb.com/reinitialiser
# Fenêtre d'inscription des invités (ISO 8601) et jours de l'événement
INVITES_OUVERTURE=2026-11-01T00:00:00Z
INVITES_CLOTURE=2027-01-26T23:59:59Z
INVITES_JOURS=2027-01-27,2027-01-28,2027-01-29
# Deux serveurs séparés seulement (voir docs/deploiement-render.md) ; sinon laisser vides
SERVICE=
BADGES_SERVICE_URL=
BADGES_SERVICE_KEY=
