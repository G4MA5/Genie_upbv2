# Backend Next.js (invites, personnel, connexion). Local : npm run dev dans backend/ (port 3000).
VITE_API_URL=http://localhost:3000
# Service des badges du backend Next.js (meme serveur en local ; autre serveur s'il est separe).
VITE_BADGES_URL=http://localhost:3000
# Backend FastAPI (inscriptions etudiants et equipes, dossier backend/inscriptions-equipes).
# Local : laisser vide, Vite redirige /api/... vers http://127.0.0.1:8000 (vite.config.ts).
# Production : URL du projet FastAPI deploye, ex. https://genie-inscriptions.vercel.app
VITE_EQUIPES_API_URL=
