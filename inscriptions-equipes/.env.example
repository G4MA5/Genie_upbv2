# Copier en .env (ici ou dans backend/.env) et compléter. En production, définir ces variables
# dans l'hébergeur (Vercel / Render). Ne jamais committer le vrai .env.

# Base Supabase : préférer le pooler en mode transaction (port 6543) en serverless
DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe-encode>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase Storage (clé secrète sb_secret_… ou service_role, côté serveur uniquement)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BACKEND=supabase

# API base étudiants UPB
UPB_API_URL=https://api.dbupb.synapstic.tech
UPB_API_KEY=
UPB_API_MODE=live

# Brevo (e-mails)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=GÉNIE UPB
EMAIL_ENABLED=true

# Sessions candidats (32 caractères minimum) et accès organisateurs
JWT_SECRET=
ADMIN_API_KEY=

# Frontend autorisé (CORS) et liens dans les e-mails
FRONTEND_URL=https://genie-upb.com
CORS_ORIGINS=https://genie-upb.com,http://localhost:5173
